.gitignore
.github
.env
.env.*
!.env.example
.venv
venv
env
*.db
*.sqlite3
data/
htmlcov/
.coverage
.pytest_cache
.ruff_cache
.mypy_cache
__pycache__/
*.py[cod]
*.log

