# DiffLens — Environment Configuration
# Copy this file to .env and fill in the values.
# All variables have sensible defaults for local Docker Compose development.

# Database────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://difflens:changeme@db:5432/difflens

# Application─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# URL of the frontend dashboard, reported by the API root endpoint.
DASHBOARD_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM / Ollama───────────────────────────────────────────────────────
# Set to the Ollama container name in Docker Compose. If running Ollama
# on the host machine, change to http://host.docker.internal:11434.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=codellama:7b
LLM_TIMEOUT=120.0

# ML Feature Flags───────────────────────────────────────────────────
# Disable any of these if you don't need them or want faster analysis.
ML_ENABLE_SMART_REVIEW=true
ML_ENABLE_RISK_SCORING=true
ML_ENABLE_SIMILARITY=true
ML_ENABLE_CATEGORIZATION=true

# GitHub Integration──────────────────────────────────────────────────
# To enable GitHub webhook integration:
#
# 1. Create a fine-grained Personal Access Token at:
#    https://github.com/settings/tokens?type=beta
#    Required permissions:
#      - Pull requests: Read and write
#      - Commit statuses: Read and write
#      - Contents: Read (to fetch diffs)
#      - Checks: Read and write (optional, for check run annotations)
#
# 2. Generate a webhook secret:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 3. Configure the webhook on your GitHub repo:
#    Settings → Webhooks → Add webhook
#    - Payload URL: https://your-public-url/api/v1/github/webhook
#    - Content type: application/json
#    - Secret: paste the value from GITHUB_WEBHOOK_SECRET below
#    - Events: select "Pull requests" only

# GITHUB_TOKEN=REPLACE_WITH_YOUR_GITHUB_TOKEN
# GITHUB_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Post a summary comment on analyzed PRs (default: true)
GITHUB_POST_COMMENT=true
# Post inline review comments on error/critical findings (default: true)
GITHUB_POST_REVIEW=true
# Use the Checks API for annotations (needs checks:write scope)
GITHUB_USE_CHECKS_API=false
# Analyze draft PRs (default: false — skip drafts)
GITHUB_ANALYZE_DRAFTS=false
# Run the LLM smart review on webhook-triggered analyses (adds latency)
GITHUB_ENABLE_SMART_REVIEW=false

# Public URL for "Details" links in GitHub commit statuses.
# Leave blank if you only use DiffLens locally.
# APP_PUBLIC_URL=https://difflens.example.com
