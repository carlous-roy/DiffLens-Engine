# DiffLens — environment configuration
# Copy this file to .env and fill in the values. Every variable has a default
# except POSTGRES_PASSWORD (docker compose refuses to start without it).

# Database ------------------------------------------------------------------
# Docker Compose builds DATABASE_URL from these. Running without Docker, the
# default is a local SQLite file (sqlite:///./difflens.db).
POSTGRES_USER=difflens
POSTGRES_PASSWORD=
POSTGRES_DB=difflens
# DATABASE_URL=postgresql://difflens:password@localhost:5432/difflens

# Run `alembic upgrade head` at startup. Unset: on in development, off elsewhere.
# The compose file sets it to true for the app container.
# AUTO_MIGRATE=true

# Application ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Shared secret for POST /api/v1/github/analyze-pr, POST /api/v1/smart-review
# and /api/v1/analyze with the LLM pass. Those routes answer 503 until set.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Largest diff accepted, in bytes (submitted or fetched from GitHub).
MAX_DIFF_BYTES=2000000

# URL of the dashboard, reported by the API root endpoint.
DASHBOARD_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the compose file publishes the API and dashboard (localhost only by
# default; set the bind address to 0.0.0.0 to expose them on the network).
APP_BIND=127.0.0.1
APP_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# LLM / Ollama --------------------------------------------------------------
# ollama (default), openai (any OpenAI-compatible endpoint) or stub (canned
# answers for tests and demos). With Ollama on the host instead of in
# Compose, use http://host.docker.internal:11434.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=codellama:7b
LLM_TIMEOUT=120.0
# LLM_API_KEY=

# Feature flags -------------------------------------------------------------
ML_ENABLE_SMART_REVIEW=true
ML_ENABLE_RISK_SCORING=true
ML_ENABLE_SIMILARITY=true
ML_ENABLE_CATEGORIZATION=true

# Embeddings and clustering -------------------------------------------------
# fastembed (BAAI/bge-small-en-v1.5 through ONNX) or hashing (lexical fallback).
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=/opt/models
# Cosine distance under which two findings are the same cluster.
CLUSTER_DISTANCE_THRESHOLD=0.15
# Related past findings need at least this combined (embedding + TF-IDF) score.
SIMILARITY_MIN_SCORE=0.6

# GitHub integration --------------------------------------------------------
# 1. Create a fine-grained Personal Access Token at
#    https://github.com/settings/tokens?type=beta with
#      Pull requests: Read and write, Commit statuses: Read and write,
#      Contents: Read, Checks: Read and write (optional).
# 2. Generate a webhook secret:
#      python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. On the repository: Settings > Webhooks > Add webhook
#      Payload URL: https://your-public-url/api/v1/github/webhook
#      Content type: application/json, Secret: the value below,
#      Events: Pull requests only.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# Post (and update) a summary comment on analyzed PRs.
GITHUB_POST_COMMENT=true
# Post inline review comments on error/critical findings.
GITHUB_POST_REVIEW=true
# Use the Checks API for annotations (needs checks:write).
GITHUB_USE_CHECKS_API=false
# Analyze draft PRs.
GITHUB_ANALYZE_DRAFTS=false
# Run the LLM review on webhook-triggered analyses (adds latency).
GITHUB_ENABLE_SMART_REVIEW=false
# Files (most changed first) whose commit history feeds the risk model's
# history features; 0 disables the lookups and uses the diff-only model.
GITHUB_HISTORY_MAX_FILES=20
# Public URL for the "Details" links in commit statuses.
# APP_PUBLIC_URL=https://difflens.example.com
